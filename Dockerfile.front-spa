FROM node:22.22.0-bookworm-slim AS base
WORKDIR /app

# Install dependencies
FROM base AS deps
RUN corepack enable npm
COPY package.json package-lock.json ./
COPY front-spa/package.json front-spa/
COPY front/package.json front/
COPY connectors/package.json connectors/
COPY sparkle/package.json sparkle/
COPY sdks/js/package.json sdks/js/
COPY viz/package.json viz/
COPY cli/dust-cli/package.json cli/dust-cli/
COPY extension/package.json extension/
RUN npm ci

# Build
FROM base AS builder
COPY --from=deps /app/ ./
COPY front-spa/ front-spa/
COPY front/ front/
COPY sparkle/ sparkle/
COPY sdks/js/ sdks/js/

# Build sparkle first (front-spa depends on it)
WORKDIR /app/sparkle
RUN npm run build 2>/dev/null || true

WORKDIR /app/sdks/js
RUN npm run build 2>/dev/null || true

WORKDIR /app/front-spa
ENV VITE_DUST_CLIENT_FACING_URL=http://localhost:3000
ENV NEXT_PUBLIC_DUST_CLIENT_FACING_URL=http://localhost:3000
ENV NEXT_PUBLIC_NOVU_APPLICATION_IDENTIFIER=fake-novu-id
ENV NEXT_PUBLIC_NOVU_APPLICATION_IDENTIFIER_US=fake-novu-id
ENV NEXT_PUBLIC_NOVU_API_URL=http://localhost:3000
ENV NEXT_PUBLIC_NOVU_API_URL_US=http://localhost:3000
ENV NEXT_PUBLIC_NOVU_WEBSOCKET_API_URL=ws://localhost:3000
ENV NEXT_PUBLIC_NOVU_WEBSOCKET_API_URL_US=ws://localhost:3000
ENV NEXT_PUBLIC_DUST_APP_URL=http://localhost:3011
ENV NEXT_PUBLIC_VIZ_URL=http://localhost:3100
ENV VITE_DUST_REGION=us-central1
RUN npm run build

# Serve with a simple static server
FROM node:22-alpine AS runner
RUN npm install -g serve
COPY --from=builder /app/front-spa/dist /app/dist

EXPOSE 3011
CMD ["serve", "-s", "/app/dist/app", "-l", "3011", "--no-clipboard"]
