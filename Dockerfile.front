FROM node:22.22.0-bookworm-slim AS base
WORKDIR /app

# Install dependencies
FROM base AS deps
RUN corepack enable npm
COPY package.json package-lock.json ./
COPY front/package.json front/
COPY connectors/package.json connectors/
COPY sparkle/package.json sparkle/
COPY sdks/js/package.json sdks/js/
COPY viz/package.json viz/
COPY cli/dust-cli/package.json cli/dust-cli/
COPY extension/package.json extension/
COPY front-spa/package.json front-spa/
RUN npm ci

# Build
FROM base AS builder
COPY --from=deps /app/ ./
COPY front/ front/
COPY sdks/js/ sdks/js/
COPY sparkle/ sparkle/

# Build sparkle and SDK first (front depends on them)
WORKDIR /app/sparkle
RUN npm run build 2>/dev/null || true
WORKDIR /app/sdks/js
RUN npm run build 2>/dev/null || true

WORKDIR /app/front

# Next.js build needs some env vars at build time
ENV NEXT_PUBLIC_DUST_CLIENT_FACING_URL=http://localhost:3000
ENV NEXT_PUBLIC_DUST_APP_URL=http://localhost:3011
# Next.js build requires significant memory. Docker Desktop needs >= 12GB RAM allocated.
ENV NODE_OPTIONS="--max-old-space-size=8192"

# Next.js collects page data at build time, which imports server modules that read env vars.
# Provide dummy values so the build completes; real values are injected at runtime.
ENV FRONT_DATABASE_URI=postgres://build:build@localhost/build
ENV FRONT_DATABASE_READ_REPLICA_URI=postgres://build:build@localhost/build
ENV REDIS_URI=redis://localhost
ENV REDIS_CACHE_URI=redis://localhost
ENV CORE_API=http://localhost:3001
ENV CONNECTORS_API=http://localhost:3002
ENV OAUTH_API=http://localhost:3006
ENV DUST_FRONT_API=http://localhost:3000
ENV DUST_FRONT_INTERNAL_API=http://localhost:3000
ENV ELASTICSEARCH_URL=http://localhost:9200
ENV ELASTICSEARCH_USERNAME=elastic
ENV ELASTICSEARCH_PASSWORD=build
ENV TEXT_EXTRACTION_URL=http://localhost:9998
ENV TEMPORAL_NAMESPACE=default

RUN npm run build

RUN npm run build:workers
RUN npm run build:temporal-bundles

# Runner
FROM base AS runner
ENV NODE_ENV=production

COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/front ./front
COPY --from=builder /app/sdks/js ./sdks/js
COPY --from=builder /app/sparkle ./sparkle
COPY --from=builder /app/package.json ./
COPY docker-entrypoint.sh /usr/local/bin/

WORKDIR /app/front

ENTRYPOINT ["docker-entrypoint.sh"]

ARG TARGET=web
ENV TARGET=${TARGET}

ENV USE_TEMPORAL_BUNDLES=true

CMD if [ "$TARGET" = "worker" ]; then \
      node dist/start_worker.js; \
    elif [ "$TARGET" = "initdb" ]; then \
      npx tsx admin/db.ts; \
    else \
      node .next/standalone/front/server.js; \
    fi

EXPOSE 3000
