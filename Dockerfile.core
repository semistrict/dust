FROM rust:1.86-bookworm AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    cmake g++ protobuf-compiler libprotobuf-dev pkg-config libssl-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app/core
COPY core/ .

# Build all binaries in release mode
RUN cargo build --release --bin core-api --bin oauth --bin sqlite-worker --bin init_db

# Runtime image
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates libssl3 libpq5 curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/core/target/release/core-api /usr/local/bin/core-api
COPY --from=builder /app/core/target/release/oauth /usr/local/bin/oauth
COPY --from=builder /app/core/target/release/sqlite-worker /usr/local/bin/sqlite-worker
COPY --from=builder /app/core/target/release/init_db /usr/local/bin/init_db

ARG BIN_NAME=core-api
ENV BIN_NAME=${BIN_NAME}

CMD ${BIN_NAME}
