# =============================================================================
# Dust Docker Compose Configuration
# Copy to .env and fill in required values.
# =============================================================================

# --- Infrastructure -----------------------------------------------------------

# Elasticsearch
ES_LOCAL_VERSION=8.14.3
ES_LOCAL_CONTAINER_NAME=dust-elasticsearch
ES_LOCAL_PORT=9200
ES_LOCAL_HEAP_INIT=512m
ES_LOCAL_HEAP_MAX=512m
ELASTICSEARCH_PASSWORD=dust-dev-password
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_USERNAME=elastic

# Kibana (optional, remove kibana services if not needed)
KIBANA_LOCAL_PASSWORD=kibana-dev-password
KIBANA_LOCAL_CONTAINER_NAME=dust-kibana
KIBANA_LOCAL_PORT=5601
KIBANA_ENCRYPTION_KEY=your-32-char-encryption-key-here

# Redis
REDIS_URI=redis://redis:6379
REDIS_CACHE_URI=redis://redis:6379

# Qdrant
QDRANT_CLUSTER_0_URL=http://qdrant:6334
QDRANT_USE_SHARDING=false

# --- PostgreSQL Databases -----------------------------------------------------
# All 4 databases are created by the db-init service on first run.
CORE_DATABASE_URI=postgres://dev:dev@db:5432/dust_api
CORE_DATABASE_READ_REPLICA_URI=postgres://dev:dev@db:5432/dust_api
FRONT_DATABASE_URI=postgres://dev:dev@db:5432/dust_front
FRONT_DATABASE_READ_REPLICA_URI=postgres://dev:dev@db:5432/dust_front
CONNECTORS_DATABASE_URI=postgres://dev:dev@db:5432/dust_connectors
CONNECTORS_DATABASE_READ_REPLICA_URI=postgres://dev:dev@db:5432/dust_connectors
OAUTH_DATABASE_URI=postgres://dev:dev@db:5432/dust_oauth

# --- Temporal -----------------------------------------------------------------
TEMPORAL_NAMESPACE=default
TEMPORAL_CONNECTORS_NAMESPACE=default
TEMPORAL_AGENT_NAMESPACE=default

# --- Inter-service URLs -------------------------------------------------------
CORE_API=http://core:3001
OAUTH_API=http://oauth:3006
CONNECTORS_API=http://connectors:3002
DUST_FRONT_API=http://front:3000
DUST_FRONT_INTERNAL_API=http://front:3000
DUST_CLIENT_FACING_URL=http://localhost:3000
DUST_PUBLIC_URL=http://localhost:3000
CONNECTORS_PUBLIC_URL=http://localhost:3002
TEXT_EXTRACTION_URL=http://apache-tika:9998

# --- Front (Next.js) ---------------------------------------------------------
NEXT_PUBLIC_DUST_CLIENT_FACING_URL=http://localhost:3000
NEXT_PUBLIC_DUST_APP_URL=http://localhost:3000
POKE_APP_URL=http://localhost:3000/poke
DUST_AUTH_REDIRECT_BASE_URL=http://localhost:3000

# Viz
VIZ_PUBLIC_URL=http://localhost:3100
NEXT_PUBLIC_VIZ_URL=http://localhost:3100

# --- Secrets (generate your own) ----------------------------------------------
# Generate with: openssl rand -hex 32
DUST_INVITE_TOKEN_SECRET=change-me-to-random-secret
DUST_REGISTRY_SECRET=change-me-to-random-secret
DUST_CONNECTORS_SECRET=change-me-to-random-secret
DUST_CONNECTORS_WEBHOOKS_SECRET=change-me-to-random-secret
VIZ_JWT_SECRET=change-me-to-random-secret
DUST_ACADEMY_JWT_SECRET=change-me-to-random-secret
DUST_SANDBOX_JWT_SECRET=change-me-to-random-secret
EMAIL_WEBHOOK_SECRET=change-me-to-random-secret
EMAIL_VALIDATION_SECRET=change-me-to-random-secret
GATED_ASSETS_TOKEN_SECRET=change-me-to-random-secret
DUST_DEVELOPERS_SECRETS_SECRET=change-me-to-random-secret
DUST_MCP_SERVER_CREDENTIALS_SECRET=change-me-to-random-secret
DUST_DEVELOPMENT_SYSTEM_API_KEY=change-me-to-random-secret
DUST_DEVELOPMENT_WORKSPACE_ID=change-me

# --- WorkOS (authentication) --------------------------------------------------
# Create a WorkOS account at https://workos.com and fill these in.
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_COOKIE_PASSWORD=change-me-to-32-char-password-xx
WORKOS_ISSUER_URL=
WORKOS_WEBHOOK_SECRET=
WORKOS_WEBHOOK_SIGNING_SECRET=
WORKOS_ACTION_SECRET=
WORKOS_ACTION_SIGNING_SECRET=
WORKOS_ENVIRONMENT_ID=

# --- Core (Rust) API keys ----------------------------------------------------
CORE_API_KEY=
OAUTH_API_KEY=

# --- sqlite-worker ------------------------------------------------------------
IS_LOCAL_DEV=true

# --- Optional: LLM provider keys (set the ones you need) ---------------------
# Direct provider keys (for Dust-managed plans):
# DUST_MANAGED_OPENAI_API_KEY=
# DUST_MANAGED_ANTHROPIC_API_KEY=
# DUST_MANAGED_MISTRAL_API_KEY=
# DUST_MANAGED_GOOGLE_AI_STUDIO_API_KEY=
# DUST_MANAGED_XAI_API_KEY=
# DUST_MANAGED_DEEPSEEK_API_KEY=
# DUST_MANAGED_FIREWORKS_API_KEY=
# DUST_MANAGED_TOGETHERAI_API_KEY=
#
# OpenRouter (single key for many models via https://openrouter.ai):
# DUST_MANAGED_OPENROUTER_API_KEY=sk-or-v1-xxx

# --- Optional: External services (leave blank to disable) ---------------------
# SENDGRID_API_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_SECRET_WEBHOOK_KEY=
# IPINFO_API_TOKEN=
# SERVICE_ACCOUNT=
